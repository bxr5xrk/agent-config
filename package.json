{
  "name": "agent-config",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "desktop:preview": "rulesync generate --global --dry-run",
    "desktop:apply": "rulesync generate --global",
    "desktop:check": "rulesync generate --global --check",
    "claude:preview": "rulesync generate --global --targets claudecode --dry-run",
    "claude:apply": "rulesync generate --global --targets claudecode",
    "claude:check": "rulesync generate --global --targets claudecode --check",
    "codex:preview": "rulesync generate --global --targets codexcli --dry-run",
    "codex:apply": "rulesync generate --global --targets codexcli",
    "codex:check": "rulesync generate --global --targets codexcli --check"
  },
  "devDependencies": {
    "rulesync": "16.28.0"
  }
}
