    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 10
        }
      ]
    }
  ],
  "MessageDisplay": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 240
        }
      ]
