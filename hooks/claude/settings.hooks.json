{
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-shape-prefix.py",
          "timeout": 10
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-shape-log.py",
          "timeout": 10,
          "statusMessage": "Logging answer shape"
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 10
        }
      ]
    }
  ],
  "MessageDisplay": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 240
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/push-merged-pr-guard.sh",
          "if": "Bash(git push*)",
          "timeout": 20,
          "statusMessage": "Checking PR is not merged"
        }
      ]
    },
    {
      "matcher": "AskUserQuestion",
      "hooks": [
        {
          "type": "command",
          "command": "/Users/berserk/.claude/hooks/answer-review.py",
          "timeout": 10
        }
      ]
    }
  ]
}
